{
  "name": "kkubuck-blog",
  "version": "4.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.txt",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prune-export.mjs && node scripts/create-legacy-redirects.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "npm run build && node scripts/verify-build.mjs",
    "parity": "node scripts/parity-check.mjs",
    "clean": "rm -rf .next out",
    "package": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "@shikijs/rehype": "4.5.0",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "hast-util-to-string": "3.0.1",
    "next": "16.3.8",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
