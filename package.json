{
  "name": "kkubuck-research-interface",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build:astro": "astro build",
    "build": "astro build && node scripts/create-legacy-redirects.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "astro check && astro build && node scripts/create-legacy-redirects.mjs && node scripts/verify-build.mjs",
    "clean": "rm -rf dist .astro",
    "package": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.13.1"
}
