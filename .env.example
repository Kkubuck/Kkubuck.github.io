# Optional. Read by `next build` and by the post-build scripts alike
# (scripts/site-config.mjs). In CI, actions/configure-pages supplies both.

# Absolute site origin for canonical URLs, RSS and the sitemap. Origin only,
# no path: a repository path goes in BASE_PATH.
SITE_URL=https://kkubuck.github.io

# Leave empty for the Kkubuck.github.io user-site repository.
# For a project repository, use /repository-name.
BASE_PATH=
