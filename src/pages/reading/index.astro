---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readingPlans, groups, RESEARCH_UPDATED } from '../../data/research';
import { getResearch } from '../../lib/research';
import { withBase } from '../../lib/paths';
const { nodes } = await getResearch();
---
<BaseLayout title="Reading desk" description="OVCOS와 인접 연구를 읽고 쓸 순서. 비교 질문, 글의 목차, 원문을 12개 주제로 정리했습니다." lang="ko">
  <section class="container reading-page">
    <div class="section-heading"><div><p class="kicker">Research / 02</p><h1>Reading desk<span class="title-dot">.</span></h1><p>다음에 읽고, 비교하고, 쓸 것들.</p></div><span class="mono muted">Updated {RESEARCH_UPDATED}</span></div>
    <div class="reading-intro"><p>OVCOS를 먼저, 인접 방법론을 그다음에. 학회·저널 논문을 중심으로 묶었습니다. 각 항목은 작성할 글의 계획이며, 완성된 글은 ‘리뷰’로 연결됩니다.</p><a class="text-link" href={withBase('/research/')}>지도에서 보기 ↗</a></div>
    <ol class="reading-list">{readingPlans.map((plan,i)=>{
      const group=groups.find(g=>g.id===plan.group)!;
      return <li id={plan.id} class="reading-item"><span class="reading-number">{String(i+1).padStart(2,'0')}</span><div><div class="reading-meta"><span style={`color:${group.color}`}>{group.ko}</span><span>{plan.priority}</span></div><h2>{plan.title}</h2><p>{plan.question}</p><div class="reading-papers">{plan.papers.map(id=>{
        const paper=nodes.find(p=>p.id===id)!;
        return <div><a href={paper.source} target="_blank" rel="noopener noreferrer">{paper.short} ↗</a><span>{paper.venue}{paper.preprint?' · 프리프린트':''}</span>{paper.review&&<a class="reading-review" href={paper.review}>리뷰 →</a>}<a class="reading-map" href={`${withBase('/research/')}?paper=${paper.id}`} aria-label={`${paper.short} 지도에서 보기`}>지도</a></div>;
      })}</div><details><summary>글 구성 <span>+</span></summary><ol>{plan.outline.map(part=><li>{part}</li>)}</ol></details></div></li>;
    })}</ol>
  </section>
</BaseLayout>
