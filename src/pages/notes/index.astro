---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Archive from '../../components/Archive.astro';
import { getPostsByKind } from '../../lib/content';

const posts = await getPostsByKind('note');
---

<BaseLayout
  title="Notes"
  description="Implementation logs, study notes, and practical checks from ongoing computer vision work."
>
  <section class="page-head">
    <div class="container">
      <p class="kicker">Archive · {posts.length} notes</p>
      <h1>Research notes.</h1>
      <p class="page-head__lede">Implementation logs and working notes kept while the work was running.</p>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <Archive posts={posts} kind="note" />
    </div>
  </section>
</BaseLayout>
