---
import BaseLayout from '../../layouts/BaseLayout.astro';
import cv from '../../data/cv.json';
import { withBase } from '../../lib/paths';

// Annotated so both groups share one element type. Without it the value is a
// union of two array types and `.map` cannot resolve a single signature.
type Publication = { title: string; authors: string; venue: string; date: string | number };

const publications: Array<{ heading: string; items: Publication[] }> = [
  { heading: 'Journal publications', items: cv.publications.journal },
  { heading: 'Conference publications', items: cv.publications.conference }
];

const skillGroups = Object.entries(cv.skills).map(([group, items]) => ({
  label: group.replace(/^./, (character) => character.toUpperCase()),
  value: items.join(' · ')
}));
---

<BaseLayout
  title="Curriculum Vitae"
  description="Curriculum vitae of Jisang Lee, computer vision researcher at Hanbat National University."
>
  <div class="container cv">
    <aside class="cv__aside">
      <p class="kicker">Curriculum vitae</p>
      <h1>{cv.profile.name}</h1>
      <p class="cv__meta">{cv.profile.role}<br />{cv.profile.affiliation}</p>
      <p class="cv__meta">
        {cv.profile.location}<br />
        <a class="link" href={`mailto:${cv.profile.email}`}>{cv.profile.email}</a>
      </p>
      <div class="cv__actions">
        <a class="button button--solid" href={withBase(cv.profile.pdf)} target="_blank" rel="noopener">PDF</a>
        <a class="button" href={cv.profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
      <p class="cv__updated">Updated {cv.profile.last_updated}</p>
    </aside>

    <div>
      <section class="cv-section">
        <h2>Education</h2>
        {cv.education.map((item) => (
          <article class="cv-item">
            <p class="cv-item__date">{item.period}</p>
            <div class="cv-item__body">
              <h3>{item.degree}</h3>
              <p>{item.institution} · {item.location}</p>
              <p>Advisor: {item.advisor}</p>
              {item.details.length > 0 && <ul>{item.details.map((detail) => <li>{detail}</li>)}</ul>}
            </div>
          </article>
        ))}
      </section>

      {publications.map((group) => (
        <section class="cv-section">
          <h2>{group.heading}</h2>
          {group.items.map((item) => (
            <article class="cv-item">
              <p class="cv-item__date">{item.date}</p>
              <div class="cv-item__body">
                <h3>{item.title}</h3>
                <p>{item.authors}</p>
                <p>{item.venue}</p>
              </div>
            </article>
          ))}
        </section>
      ))}

      <section class="cv-section">
        <h2>Research experience</h2>
        {cv.research_experience.map((item) => (
          <article class="cv-item">
            <p class="cv-item__date">{item.period}</p>
            <div class="cv-item__body">
              <h3>{item.role}</h3>
              <p>{item.organization} · {item.location}</p>
              <ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
            </div>
          </article>
        ))}
      </section>

      <section class="cv-section">
        <h2>Research projects</h2>
        {cv.research_projects.map((item) => (
          <article class="cv-item">
            <p class="cv-item__date">{item.period}</p>
            <div class="cv-item__body">
              <h3>{item.title}</h3>
              <p>{item.organization}</p>
              <ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
            </div>
          </article>
        ))}
      </section>

      <section class="cv-section">
        <h2>Awards</h2>
        {cv.awards.map((item) => (
          <article class="cv-item">
            {/* `in` guards keep this valid whether or not TypeScript widens the
                JSON union to optional properties. */}
            <p class="cv-item__date">{'date' in item ? item.date : ''}</p>
            <div class="cv-item__body">
              <h3>{item.title}</h3>
              <p>
                {'detail' in item && item.detail ? `${item.category} · ${item.detail}` : item.category}
              </p>
            </div>
          </article>
        ))}
      </section>

      <section class="cv-section">
        <h2>Teaching</h2>
        {cv.teaching.map((item) => (
          <article class="cv-item">
            <p class="cv-item__date">{item.period}</p>
            <div class="cv-item__body">
              <h3>{item.course}</h3>
              <p>{item.role} · {item.institution}</p>
            </div>
          </article>
        ))}
      </section>

      <section class="cv-section">
        <h2>Skills</h2>
        {skillGroups.map((group) => (
          <article class="cv-item">
            <p class="cv-item__date">{group.label}</p>
            <div class="cv-item__body">
              <h3>{group.value}</h3>
            </div>
          </article>
        ))}
      </section>
    </div>
  </div>
</BaseLayout>
