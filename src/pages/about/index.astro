---
import BaseLayout from '../../layouts/BaseLayout.astro';
import cv from '../../data/cv.json';
import { SITE } from '../../data/site';
import { withBase } from '../../lib/paths';

const method = [
  { step: '01', title: 'Context', body: 'The data regime, the task boundary, and the failure that motivates the method.' },
  { step: '02', title: 'Mechanism', body: 'Inputs, transformations, supervision, outputs. Not a list of module names.' },
  { step: '03', title: 'Evidence', body: 'What the authors measured, separated from what the review infers.' },
  { step: '04', title: 'Limits', body: 'Confounds, missing controls, cost, and the next experiment worth running.' }
];
---

<BaseLayout title="About" description="About Jisang Lee and how this research archive is written.">
  <section class="page-head">
    <div class="container">
      <p class="kicker">About</p>
      <h1>An archive, not a summary feed.</h1>
      <p class="page-head__lede">
        Reviews here keep the parts of a paper that stay useful once the novelty language fades.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="container split">
      <div class="stack" style="--stack: 0.875rem">
        <h2>{cv.profile.name}</h2>
        <p class="muted">{cv.profile.summary}</p>
        <p class="muted">
          Current interests: segmentation, remote sensing, medical imaging, forgery detection, and
          open-vocabulary recognition.
        </p>
        <div class="actions">
          <a class="button button--solid" href={withBase('/cv/')}>Curriculum vitae</a>
          <a class="button" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>

      <dl class="facts">
        <div><dt>Role</dt><dd>{cv.profile.role}</dd></div>
        <div><dt>Lab</dt><dd>AIMLab</dd></div>
        <div><dt>Advisor</dt><dd>{cv.profile.advisor}</dd></div>
        <div><dt>Based in</dt><dd>{cv.profile.location}</dd></div>
        <div><dt>Email</dt><dd><a class="link" href={`mailto:${cv.profile.email}`}>{cv.profile.email}</a></dd></div>
      </dl>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="band__head">
        <h2>How a review is written</h2>
      </div>
      <div class="note-grid">
        {method.map((item) => (
          <article class="note-card">
            <p class="kicker">{item.step} · {item.title}</p>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
