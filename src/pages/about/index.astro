---
import BaseLayout from '../../layouts/BaseLayout.astro';
import cv from '../../data/cv.json';
import { SITE } from '../../data/site';
import { withBase } from '../../lib/paths';
const selected=[cv.publications.journal[0]!,cv.publications.conference[0]!];
---
<BaseLayout title="About Jisang Lee" description="이지상. 한밭대학교 AIM Lab에서 위장 객체와 개방 어휘 분할을 연구합니다." lang="ko">
  <section class="container atlas-page">
    <div class="section-heading"><div><p class="kicker">About / Curriculum vitae</p><h1>Jisang Lee<span class="title-dot">.</span></h1><p>이지상 · M.S. researcher · Daejeon, Korea</p></div><a class="text-link" href={withBase('/cv/')}>Full CV ↗</a></div>
    <div class="split" style="padding-top:30px;border-top:1px solid var(--rule-2)">
      <div><h2>Computer vision</h2><p class="muted" style="margin-top:16px;max-width:560px;word-break:keep-all">한밭대학교 AIM Lab 석사과정입니다. 위장 객체와 SAR·UAV 영상처럼 시각적 단서가 약한 장면에서, 기반 모델과 언어 정보를 활용한 탐지·분할을 연구합니다.</p>
      <div class="profile-links"><a href={cv.profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a><a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={cv.profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={`mailto:${SITE.email}`}>Email ↗</a></div>
      <div class="profile-selected">{selected.map(p=><article><p class="mono">{p.venue} · {p.date}<span class="profile-status">{p.status}</span></p><h3>{p.title}</h3><p>{p.authors}</p></article>)}</div>
      <p class="profile-source">실적 및 심사 상태: <a href={cv.profile.source} target="_blank" rel="noopener noreferrer">공개 GitHub 프로필</a> · 2026.10.02 기준</p></div>
      <dl class="facts"><div><dt>Education</dt><dd>M.S. Computer Engineering<br/>Hanbat National University<br/>2025.03 – Present</dd></div><div><dt>Lab / Advisor</dt><dd>AIM Lab<br/>{cv.profile.advisor}</dd></div><div><dt>Research</dt><dd>Camouflaged object segmentation<br/>Open-vocabulary vision<br/>Remote sensing</dd></div><div><dt>2026 competitions</dt><dd>2nd / 66 · Cyrillic Morphological Induction<br/>2nd / 81 · National Park Satellite Monitoring</dd></div></dl>
    </div>
  </section>
</BaseLayout>
