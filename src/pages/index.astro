---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import { getAllPosts, tagSlug } from '../lib/content';
import { withBase } from '../lib/paths';
import cv from '../data/cv.json';

const posts = await getAllPosts();
const papers = posts.filter((post) => post.data.kind === 'paper');
const notes = posts.filter((post) => post.data.kind === 'note');
const latest = posts.slice(0, 8);

// Counted by slug so this figure matches the number shown on /tags/.
const topics = new Set(posts.flatMap((post) => post.data.tags.map(tagSlug)).filter(Boolean)).size;

const index = [
  { href: withBase('/papers/'), value: papers.length, label: 'Paper reviews' },
  { href: withBase('/notes/'), value: notes.length, label: 'Research notes' },
  { href: withBase('/tags/'), value: topics, label: 'Topics' }
];
---

<BaseLayout>
  <section class="intro">
    <div class="container">
      <p class="kicker">Archive · Since 2022</p>
      <h1 class="intro__title">Reading computer vision closely.</h1>
      <p class="intro__lede">Paper reviews, implementation notes, and research logs by {cv.profile.name}.</p>
      <div class="actions">
        <a class="button button--solid" href={withBase('/papers/')}>Browse papers</a>
        <button class="button" type="button" data-search-open>Search archive</button>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="band__head">
        <h2>Latest</h2>
        <a class="link--quiet" href={withBase('/papers/')}>All papers →</a>
      </div>
      <ul class="entry-list">
        {latest.map((post) => <PostRow post={post} />)}
      </ul>
    </div>
  </section>

  <section class="band band--tight">
    <div class="container">
      <div class="index-grid">
        {index.map((item) => (
          <a class="index-tile" href={item.href}>
            <span class="index-tile__value">{item.value}</span>
            <span class="index-tile__label">
              {item.label}
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container colophon">
      <p>{cv.profile.summary}</p>
      <a class="link" href={withBase('/about/')}>About</a>
    </div>
  </section>
</BaseLayout>
