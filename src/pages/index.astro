---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import ResearchAtlas from '../components/ResearchAtlas.astro';
import { getAllPosts } from '../lib/content';
import { withBase } from '../lib/paths';
import { readingPlans, additions } from '../data/research';
import { SITE } from '../data/site';
const posts=await getAllPosts();
const papers=posts.filter(p=>p.data.kind==='paper');
---
<BaseLayout lang="ko">
  <section class="home-intro container">
    <div>
      <p class="eyebrow"><span class="status-dot"></span>Computer vision · AIM Lab, Hanbat</p>
      <h1>Jisang Lee<span class="title-dot">.</span></h1>
      <p class="home-role">이지상 <span>/</span> Computer vision researcher</p>
      <p class="home-description">위장 객체와 개방 어휘 분할을 연구합니다.<br />읽은 논문과 연구 과정의 기록을 모읍니다.</p>
      <div class="home-links"><a href={withBase('/about/')}>About & CV ↗</a><a href="https://scholar.google.com/citations?user=54qWclUAAAAJ" target="_blank" rel="noopener noreferrer">Scholar ↗</a><a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={`mailto:${SITE.email}`}>Email ↗</a></div>
    </div>
    <aside class="home-updates" aria-label="Selected research">
      <p class="eyebrow">Selected research <span>2026</span></p>
      <a href={withBase('/cv/#publications')}><span class="home-updates__meta">Pattern Recognition <i>Accepted</i></span><strong>HFGF-DINOv3</strong><span>High-frequency guided fusion for camouflage</span></a>
      <a href={withBase('/cv/#publications')}><span class="home-updates__meta">ACCV 2026 <i>Accepted</i></span><strong>Uncertainty-guided OVCOS</strong><span>Structural routing & consensus-aware re-ranking</span></a>
      <a class="home-updates__all" href={withBase('/cv/')}>Publications & experience <span>→</span></a>
    </aside>
  </section>
  <section class="home-atlas container">
    <div class="section-heading"><div><p class="kicker">01 / Research landscape</p><h2>Research atlas</h2><p>주제로 모아 보고, 논문 사이를 이어 봅니다.</p></div><span class="section-stat">{papers.length+additions.length} entries <span>/</span> 6 themes</span></div>
    <ResearchAtlas compact />
  </section>
  <section class="container home-writing">
    <div class="section-heading"><div><p class="kicker">02 / From the notebook</p><h2>Recent writing</h2></div><a class="text-link" href={withBase('/papers/')}>전체 리뷰 →</a></div>
    <ul class="entry-list">{posts.slice(0,5).map(post=><PostRow post={post}/>)}</ul>
  </section>
  <section class="container home-reading">
    <div class="section-heading"><div><p class="kicker">03 / Up next</p><h2>On the reading desk</h2></div><a class="text-link" href={withBase('/reading/')}>글 계획 12개 →</a></div>
    <div class="home-reading__grid">{readingPlans.slice(0,4).map((plan,i)=><a href={`${withBase('/reading/')}#${plan.id}`}><span class="mono">0{i+1} <span>↗</span></span><h3>{plan.title}</h3><p>{plan.question}</p></a>)}</div>
  </section>
</BaseLayout>
