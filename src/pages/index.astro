---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignalField from '../components/SignalField.astro';
import ScrollNarrative from '../components/ScrollNarrative.astro';
import PostRow from '../components/PostRow.astro';
import { getAllPosts } from '../lib/content';
import { withBase } from '../lib/paths';
import cv from '../data/cv.json';

const posts = await getAllPosts();
const papers = posts.filter((post) => post.data.kind === 'paper');
const notes = posts.filter((post) => post.data.kind === 'note');
const venues = new Set(papers.map((post) => post.data.venue).filter(Boolean));
const latest = posts.slice(0, 6);
---
<BaseLayout>
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__copy">
        <span class="eyebrow">Computer vision · research notes</span>
        <h1>Making difficult research <span>legible.</span></h1>
        <p class="hero__lead">Paper reviews, implementation notes, and research logs focused on segmentation, remote sensing, open-vocabulary learning, and the evidence behind model claims.</p>
        <div class="hero__actions">
          <a class="button button--primary" href={withBase('/papers/')}>Explore papers <span aria-hidden="true">↗</span></a>
          <button class="button" type="button" data-search-open>Search archive <span aria-hidden="true">⌘K</span></button>
        </div>
        <div class="hero__status" aria-hidden="true">
          <svg viewBox="0 0 18 28" fill="none" stroke="currentColor"><rect x="1" y="1" width="16" height="26" rx="8"></rect><path d="M9 7v5"></path></svg>
          Scroll to inspect the system
        </div>
      </div>
      <div class="hero__visual"><SignalField /></div>
    </div>
  </section>

  <section class="metric-strip" aria-label="Archive summary">
    <div class="metric"><p class="metric__value">{papers.length}</p><p class="metric__label">Paper reviews</p></div>
    <div class="metric"><p class="metric__value">{notes.length}</p><p class="metric__label">Research notes</p></div>
    <div class="metric"><p class="metric__value">{venues.size}</p><p class="metric__label">Venues covered</p></div>
    <div class="metric"><p class="metric__value">2022—26</p><p class="metric__label">Archive range</p></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div><span class="eyebrow">Latest writing</span><h2>Recently reviewed and tested.</h2></div>
        <p>The archive separates what a paper reports from what the design plausibly explains, with explicit attention to data, supervision, compute, and failure modes.</p>
      </div>
      <div class="post-list">
        {latest.map((post, index) => <PostRow post={post} index={index} />)}
      </div>
      <p style="margin-top: 28px"><a class="text-link" href={withBase('/papers/')}>View the complete paper archive</a></p>
    </div>
  </section>

  <ScrollNarrative />

  <section class="section">
    <div class="container">
      <div class="profile-panel" data-reveal>
        <div class="profile-panel__copy">
          <span class="eyebrow">Researcher</span>
          <h2>Jisang Lee studies visual systems under real-world constraints.</h2>
          <p>{cv.profile.summary}</p>
          <p><a class="text-link" href={withBase('/about/')}>About this archive</a></p>
        </div>
        <div class="profile-panel__meta">
          <dl class="definition-list">
            <div><dt>Role</dt><dd>{cv.profile.role}</dd></div>
            <div><dt>Lab</dt><dd>AIMLab</dd></div>
            <div><dt>Base</dt><dd>{cv.profile.location}</dd></div>
            <div><dt>Focus</dt><dd>Computer vision · Remote sensing</dd></div>
          </dl>
          <a class="button" href={withBase('/cv/')}>Open curriculum vitae</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
