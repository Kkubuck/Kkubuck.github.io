---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, tagSlug, titleCaseTag } from '../../lib/content';
import { withBase } from '../../lib/paths';
const posts = await getAllPosts();
const counts = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) || 0) + 1);
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<BaseLayout title="Tags" description="Browse the Kkubuck research archive by topic and method.">
  <div class="container">
    <header class="page-intro">
      <div><span class="eyebrow">Topic index · {tags.length} tags</span><h1>Navigate by concept, method, or domain.</h1></div>
      <p class="page-intro__copy">Tags are editorial signals rather than a rigid taxonomy. Each link opens the relevant archive with that term pre-filled.</p>
    </header>
    <section class="section--compact">
      <div class="tag-index">
        {tags.map(([tag, count]) => (
          <a id={`tag-${tagSlug(tag)}`} href={`${withBase('/papers/')}?q=${encodeURIComponent(tag)}`}>
            <strong>{titleCaseTag(tag)}</strong><span>{count} {count === 1 ? 'entry' : 'entries'}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
