---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Archive from '../../components/Archive.astro';
import { getPostsByKind } from '../../lib/content';

const posts = await getPostsByKind('paper');
---

<BaseLayout
  title="Papers"
  description="Paper reviews across computer vision: segmentation, remote sensing, and open-vocabulary learning."
>
  <section class="page-head">
    <div class="container">
      <p class="kicker">Archive · {posts.length} reviews</p>
      <h1>Paper reviews.</h1>
      <p class="page-head__lede">What the paper claims, how it works, and where the evidence stops.</p>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <Archive posts={posts} kind="paper" />
    </div>
  </section>
</BaseLayout>
