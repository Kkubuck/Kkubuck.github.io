---
import BaseLayout from '../../layouts/BaseLayout.astro';
import cv from '../../data/cv.json';
import projects from '../../data/projects.json';
---

<BaseLayout title="Projects" description="Research programs and software built by Jisang Lee.">
  <section class="page-head">
    <div class="container">
      <p class="kicker">Selected work</p>
      <h1>Projects.</h1>
      <p class="page-head__lede">Research programs, experimental pipelines, and the tools around them.</p>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="band__head"><h2>Research programs</h2></div>
      <div class="note-grid">
        {cv.research_projects.map((project) => (
          <article class="note-card">
            <p class="kicker">{project.period} · {project.organization}</p>
            <h3>{project.title}</h3>
            <ul>{project.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="band__head"><h2>Code</h2></div>
      <div class="note-grid">
        {projects.map((project) => (
          <a class="note-card" href={project.url} target="_blank" rel="noopener noreferrer">
            <p class="kicker">{project.period}</p>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
