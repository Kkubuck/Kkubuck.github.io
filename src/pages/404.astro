---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Not Found" description="The requested page could not be found." noindex>
  <div class="container not-found">
    <div>
      <p class="kicker">404</p>
      <h1>Page not found.</h1>
      <p>The address may have changed. Search the archive or start from the index.</p>
      <div class="actions not-found__actions">
        <a class="button button--solid" href={withBase('/')}>Home</a>
        <button class="button" type="button" data-search-open>Search archive</button>
      </div>
    </div>
  </div>
</BaseLayout>
