---
import type { Post } from '../lib/content';
import { getPostUrl, shortDate } from '../lib/content';

interface Props {
  post: Post;
  /** Adds the metadata attributes the archive filter reads. */
  filterable?: boolean | undefined;
}

const { post, filterable = false } = Astro.props;

const summary = post.data.summary || post.data.description;
const year = String(post.data.paperYear || post.data.pubDate.getFullYear());

// Shown only when it carries information. Printing "Note" on every note row
// would fill the column with the same word 27 times.
const venue = post.data.venue ?? '';
const haystack = [post.data.title, summary, venue, ...post.data.tags].join(' ');
---

<li
  class="entry"
  data-filter-row={filterable ? '' : undefined}
  data-search={filterable ? haystack : undefined}
  data-year={filterable ? year : undefined}
  data-venue={filterable ? venue : undefined}
>
  <a class="entry__link" href={getPostUrl(post)}>
    <time class="entry__date" datetime={post.data.pubDate.toISOString()}>{shortDate(post.data.pubDate)}</time>

    <span class="entry__body">
      <span class="entry__title">{post.data.title}</span>
      {summary && <span class="entry__summary">{summary}</span>}
    </span>

    <span class="entry__venue">{venue}</span>
  </a>
</li>
