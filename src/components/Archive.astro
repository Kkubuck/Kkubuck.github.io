---
import type { Post } from '../lib/content';
import PostRow from './PostRow.astro';

interface Props {
  posts: Post[];
  kind: 'paper' | 'note';
}

const { posts, kind } = Astro.props;

const years = [
  ...new Set(posts.map((post) => String(post.data.paperYear || post.data.pubDate.getFullYear())))
].sort((a, b) => Number(b) - Number(a));

const venues = [
  ...new Set(posts.map((post) => post.data.venue).filter((venue): venue is string => Boolean(venue)))
].sort((a, b) => a.localeCompare(b));

// A select with a single option is a control that cannot change anything.
const showVenueFilter = venues.length > 1;
const noun = kind === 'paper' ? 'reviews' : 'notes';
---

<div data-archive>
  <div class="filters" role="search">
    <div class="filters__search">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <circle cx="7" cy="7" r="4.5"></circle><path d="m10.5 10.5 3 3" stroke-linecap="round"></path>
      </svg>
      <label class="sr-only" for="archive-query">Filter these {noun}</label>
      <input
        id="archive-query"
        type="search"
        data-filter-query
        placeholder={`Filter ${noun} by title, method, or tag`}
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    <label class="sr-only" for="archive-year">Year</label>
    <select id="archive-year" data-filter-year>
      <option value="">All years</option>
      {years.map((year) => <option value={year}>{year}</option>)}
    </select>

    {showVenueFilter && (
      <Fragment>
        <label class="sr-only" for="archive-venue">Venue</label>
        <select id="archive-venue" data-filter-venue>
          <option value="">All venues</option>
          {venues.map((venue) => <option value={venue}>{venue}</option>)}
        </select>
      </Fragment>
    )}

    <button class="filters__reset" type="button" data-filter-reset hidden>Clear</button>
  </div>

  <p class="filters-status">
    <span data-filter-count>{posts.length} entries</span>
    <span>Newest first</span>
  </p>

  <ul class="entry-list">
    {posts.map((post) => <PostRow post={post} filterable />)}
  </ul>

  <p class="empty-state" data-filter-empty hidden>No entry matches these filters.</p>
</div>
