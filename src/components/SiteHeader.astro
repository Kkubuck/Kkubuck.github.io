---
import { NAV_ITEMS, SITE } from '../data/site';
import { withBase } from '../lib/paths';

const pathname = Astro.url.pathname;

const isCurrent = (href: string) => {
  const resolved = withBase(href);
  return href === '/' ? pathname === resolved : pathname.startsWith(resolved);
};

// Reachable from the footer on desktop; surfaced here so the mobile menu is
// not a smaller version of the site with routes missing.
const secondaryNav = [
  { href: '/tags/', label: 'Topics' },
  { href: '/cv/', label: 'CV' }
];
---

<a class="skip-link" href="#main-content">Skip to content</a>

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href={withBase('/')}>{SITE.name}</a>

    <nav class="site-nav" aria-label="Primary">
      {NAV_ITEMS.map((item) => (
        <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="site-header__tools">
      <button class="search-trigger" type="button" data-search-open>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5"></circle><path d="m10.5 10.5 3 3" stroke-linecap="round"></path>
        </svg>
        <span class="search-trigger__label">Search archive</span>
        <span class="search-trigger__keys" data-shortcut-hint>⌘K</span>
      </button>

      <button class="icon-button icon-button--search" type="button" data-search-open aria-label="Search archive">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5"></circle><path d="m10.5 10.5 3 3" stroke-linecap="round"></path>
        </svg>
      </button>

      <button class="icon-button" type="button" data-theme-toggle aria-label="Switch theme">
        <svg class="glyph-sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.35" aria-hidden="true">
          <circle cx="8" cy="8" r="2.9"></circle>
          <path d="M8 1.4v1.5M8 13.1v1.5M1.4 8h1.5M13.1 8h1.5M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M12.6 3.4l-1.1 1.1M4.5 11.5l-1.1 1.1" stroke-linecap="round"></path>
        </svg>
        <svg class="glyph-moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.35" aria-hidden="true">
          <path d="M13.4 9.8A5.8 5.8 0 0 1 6.2 2.6a5.9 5.9 0 1 0 7.2 7.2Z" stroke-linejoin="round"></path>
        </svg>
      </button>

      <button
        class="icon-button nav-toggle"
        type="button"
        data-nav-toggle
        aria-controls="mobile-navigation"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <line class="nav-toggle__top" x1="2.5" y1="5.5" x2="13.5" y2="5.5" stroke-linecap="round"></line>
          <line class="nav-toggle__bottom" x1="2.5" y1="10.5" x2="13.5" y2="10.5" stroke-linecap="round"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<nav id="mobile-navigation" class="mobile-nav" data-mobile-nav data-open="false" aria-label="Menu">
  {NAV_ITEMS.map((item) => (
    <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
  ))}
  {secondaryNav.map((item) => (
    <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
  ))}
</nav>
