---
import { getResearch } from '../lib/research';
import { withBase } from '../lib/paths';
import { featureLabels } from '../data/research';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const data = await getResearch();
const featured = new Set(['ovcos-ovcoser-eccv2024', 'seeing-the-unseen-suclip', 'baclip', 'ovcis-diffusion', 'cat-seg', 'corrclip', 'run', 'fsel-cod-eccv2024', 'vscode-v2', 'mm-sam-camouflaged-scene-segmentation', 'rise-unsupervised-cod', 'ease-environment-aware-unsupervised-cod', 'reattnclip', 'tsp-sam-vcod-cvpr2024']);
const selected = data.nodes.find(p => p.id === 'baclip')!;
const years = [...new Set(data.nodes.map(p => p.year))].sort((a,b)=>b-a);
---
<div class:list={['atlas', { 'atlas--compact': compact }]} data-atlas data-compact={String(compact)}>
  <div class="atlas__toolbar">
    <div class="atlas__modes" role="group" aria-label="지도 보기">
      <button type="button" data-atlas-mode="topic" aria-pressed="true">주제별</button>
      <button type="button" data-atlas-mode="pca" aria-pressed="false">연구 차원</button>
      <button type="button" data-atlas-mode="list" aria-pressed="false">목록</button>
    </div>
    <span class="atlas__count" data-atlas-count aria-live="polite">{data.nodes.length} entries</span>
    {!compact && <a class="atlas__download" href={withBase('/research/data.json')} download="research-atlas.json">데이터 ↓</a>}
  </div>
  {!compact && <div class="atlas__filters">
    <label class="atlas__search"><span class="sr-only">논문 검색</span><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="5.5"/><path d="m12 12 5 5"/></svg><input type="search" placeholder="논문, 주제, 학회 검색" data-atlas-query /></label>
    <label><span class="sr-only">리뷰 상태</span><select data-atlas-status aria-label="리뷰 상태"><option value="all">전체 상태</option><option value="reviewed">리뷰 있음</option><option value="queued">읽을 논문</option></select></label>
    <label><span class="sr-only">발표 연도</span><select data-atlas-year aria-label="발표 연도"><option value="all">전체 연도</option>{years.map(y=><option value={y}>{y}</option>)}</select></label>
    <label class="atlas__check"><input type="checkbox" data-atlas-preprints checked />프리프린트 포함</label>
    <button type="button" class="text-button" data-atlas-reset>초기화</button>
  </div>}
  <div class="atlas__legend" role="group" aria-label="연구 주제 필터">
    <button type="button" data-atlas-group="all" aria-pressed="true">전체</button>
    {data.groups.map(group=><button type="button" data-atlas-group={group.id} aria-pressed="false"><i style={`--group-color:${group.color}`} aria-hidden="true"></i>{group.ko}</button>)}
  </div>
  <div class="atlas__body">
    <div class="atlas__canvas" data-atlas-canvas>
      <svg class="atlas__map" viewBox="0 0 900 540" role="group" aria-label="논문 관계 지도. 점을 선택하면 상세 정보를 볼 수 있습니다." data-atlas-svg>
        <defs><pattern id={compact ? 'atlas-dots-home' : 'atlas-dots'} width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="0.7" fill="currentColor" opacity="0.14"/></pattern></defs>
        <rect x="-300" y="-180" width="1800" height="1500" fill={`url(#${compact ? 'atlas-dots-home' : 'atlas-dots'})`} pointer-events="none" />
        <g class="atlas__cluster-labels" data-cluster-labels aria-hidden="true">
          {data.groups.map(group=><g data-cluster-id={group.id}><ellipse cx={group.x} cy={group.y} rx="130" ry="92" fill={group.color} opacity="0.035"/><text x={group.x - 100} y={group.y - 94}>{group.ko}</text></g>)}
        </g>
        <g class="atlas__axes" data-pca-axes data-hidden aria-hidden="true"><path d="M65 70V475H850"/><text x="765" y="503">PC 1 · {Math.round(data.projection.variance[0]! * 100)}%</text><text x="66" y="46">PC 2 · {Math.round(data.projection.variance[1]! * 100)}%</text></g>
        <g class="atlas__edges" aria-hidden="true">{data.edges.map(edge=>{
          const a=data.nodes.find(n=>n.id===edge.source)!, b=data.nodes.find(n=>n.id===edge.target)!;
          return <line data-edge-source={edge.source} data-edge-target={edge.target} x1={a.topic[0]} y1={a.topic[1]} x2={b.topic[0]} y2={b.topic[1]} data-hidden />;
        })}</g>
        {data.nodes.map(node=><g role="button" tabindex="0" aria-label={`${node.short}, ${node.venue}, ${node.review ? '리뷰 있음' : '읽을 논문'}`} aria-pressed={node.id===selected.id ? 'true' : 'false'} data-paper-id={node.id} class:list={['atlas__node', {'is-featured':featured.has(node.id)}]} style={`--node-color:${node.color};transform:translate(${node.topic[0]}px,${node.topic[1]}px)`}>
          <title>{node.title} · {node.venue}</title>
          <circle class="atlas__hit" r="16" fill="transparent" />
          <circle class="atlas__halo" r="13" />
          <circle class="atlas__point" r={node.id===selected.id ? '6' : '4.5'} fill={node.review ? node.color : 'var(--paper)'} />
          <text x="10" y="4" class="atlas__label">{node.short}</text>
        </g>)}
      </svg>
      <div class="atlas__zoom" role="group" aria-label="지도 확대"><button type="button" data-atlas-zoom="in" aria-label="확대">+</button><button type="button" data-atlas-zoom="out" aria-label="축소">−</button><button type="button" data-atlas-zoom="reset" aria-label="원래 크기">↺</button></div>
      <p class="atlas__map-key"><span>● 리뷰 있음</span><span>○ 읽을 논문</span><span class="atlas__drag-hint">드래그로 이동</span></p>
      <p class="atlas__empty" data-atlas-empty hidden>조건에 맞는 논문이 없습니다.</p>
    </div>
    <div class="atlas__list" data-atlas-list hidden>
      {data.nodes.map(node=><button type="button" class="atlas__list-row" data-list-id={node.id} aria-pressed={node.id===selected.id ? 'true' : 'false'}><span class="mono">{node.year}</span><span><strong>{node.short}</strong><small>{node.title}</small></span><span class="atlas__list-venue">{node.venue}<small>{node.review?'리뷰 있음':'읽을 논문'}</small></span></button>)}
    </div>
    <aside class="atlas__detail" data-atlas-detail aria-label="선택한 논문">
      <p class="atlas__detail-top"><span data-detail-group>OVCOS</span><span data-detail-state>읽을 논문</span></p>
      <p class="atlas__detail-venue" data-detail-venue>{selected.venue}</p>
      <h3 data-detail-short>{selected.short}</h3>
      <p class="atlas__detail-title" data-detail-title>{selected.title}</p>
      <p class="atlas__detail-summary" data-detail-summary>{selected.summary}</p>
      <div class="atlas__feature-tags" data-detail-features>{selected.features.map(f=><span>{featureLabels[f]}</span>)}</div>
      <div class="atlas__question"><p>읽을 때의 질문</p><p data-detail-question>{selected.question}</p></div>
      <div class="atlas__detail-actions"><a class="button button--solid" data-detail-source href={selected.source} target="_blank" rel="noopener noreferrer">원문 ↗</a><a class="button" data-detail-review hidden href={withBase('/papers/')}>리뷰 읽기 →</a></div>
      <a class="atlas__plan-link" data-detail-plan href={withBase('/reading/#alignment-evolution')}>관련 글 계획 →</a>
      <p class="atlas__evidence" data-detail-evidence>{selected.evidence}</p>
    </aside>
  </div>
  <div class="atlas__foot"><p data-atlas-caption>주제별 편집 분류 · 점을 선택해 관련 연구와 리뷰 탐색</p>{compact ? <a href={withBase('/research/')}>전체 지도 열기 ↗</a> : <button class="text-button" type="button" data-atlas-copy>현재 보기 링크 복사 ↗</button>}</div>
  {!compact && <details class="atlas__method"><summary>지도는 어떻게 만들어졌나요? <span>+</span></summary><div><p>기존 리뷰 {data.nodes.filter(n=>n.review).length}개와 추가 문헌 {data.nodes.filter(n=>!n.review).length}편에 연구 특성 10개를 수동으로 부여했습니다. 색은 편집상 주제 분류입니다. 자동으로 학습된 군집이나 성능 순위를 뜻하지 않습니다.</p><p>‘연구 차원’은 이진 특성을 평균 중심화한 뒤 공분산 PCA로 2차원에 투영합니다. 두 축의 설명 분산은 {(data.projection.variance.reduce((a,b)=>a+b,0)*100).toFixed(1)}%입니다. 동일 특성의 점은 겹침을 줄이기 위해 조금씩 떨어뜨려 표시하며, 원 좌표는 내려받을 수 있습니다. 필터를 바꿔도 좌표는 유지됩니다.</p><p>선은 특성 집합의 Jaccard 유사도가 0.5 이상인 상위 3개 이웃에서 생성합니다. 인용 관계를 뜻하지 않습니다. 가까운 점은 비슷한 연구 특성을 갖지만, 과제·데이터·감독 조건이 같다는 의미는 아닙니다.</p><p>추가 문헌의 확인 범위는 각 논문의 상세 패널에 표시했습니다. 목록에 추가된 논문과 완성된 리뷰는 구분합니다. 자료 확인: {data.updated}.</p><div class="atlas__loadings"><span>특성</span><span>PC 1</span><span>PC 2</span>{data.features.map((f,i)=><><span>{featureLabels[f]}</span><span>{data.projection.loadings[0]![i]!.toFixed(2)}</span><span>{data.projection.loadings[1]![i]!.toFixed(2)}</span></>)}</div></div></details>}
  <noscript><p class="atlas__noscript">대화형 지도에는 JavaScript가 필요합니다. <a href={withBase('/papers/')}>전체 리뷰</a>와 <a href={withBase('/reading/')}>읽기 목록</a>은 바로 볼 수 있습니다.</p></noscript>
  <script is:inline type="application/json" data-atlas-data set:html={JSON.stringify(data).replace(/</g,'\\u003c')}></script>
</div>
<script src="../scripts/atlas.ts"></script>
