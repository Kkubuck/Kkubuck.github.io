---
import type { MarkdownHeading } from 'astro';
import type { Post } from '../lib/content';
import { formatDate, getPostUrl, readingTime, tagSlug, titleCaseTag } from '../lib/content';
import { withBase } from '../lib/paths';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  previous?: Post | undefined;
  next?: Post | undefined;
}

const { post, headings, previous, next } = Astro.props;

const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const lede = post.data.subtitle || post.data.summary || post.data.description;
const label = post.data.kind === 'paper' ? 'Paper review' : 'Research note';
const kicker = [label, post.data.venue, post.data.paperYear].filter(Boolean).join(' · ');

const sources = [
  { href: post.data.sourceUrl, label: 'Source' },
  { href: post.data.pdfUrl, label: 'PDF' },
  { href: post.data.codeUrl, label: 'Code' }
].filter((source): source is { href: string; label: string } => Boolean(source.href));
---

<BaseLayout
  title={post.data.title}
  description={post.data.description || post.data.summary || undefined}
  lang={post.data.lang}
  type="article"
>
  <div class="read-progress" aria-hidden="true">
    <span class="read-progress__bar" data-read-progress></span>
  </div>

  <article data-article>
    <header class="article__head container">
      <p class="kicker">{kicker}</p>
      <h1 class="article__title">{post.data.title}</h1>
      {lede && <p class="article__lede">{lede}</p>}

      <div class="article__meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <span>{readingTime(post.body)}</span>
      </div>

      {/* Kept off the meta row: an author list wraps to several lines on a
          phone and would break up the separators. */}
      {post.data.authors && <p class="article__authors">{post.data.authors}</p>}

      {post.data.tags.length > 0 && (
        <div class="chips article__tags">
          {post.data.tags.map((tag) => (
            <a class="chip" href={`${withBase('/tags/')}#tag-${tagSlug(tag)}`}>{titleCaseTag(tag)}</a>
          ))}
        </div>
      )}

      <div class="article__actions">
        {sources.map((source) => (
          <a class="action" href={source.href} target="_blank" rel="noopener noreferrer">
            {source.label}
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
              <path d="M3.5 8.5 8.5 3.5M4.2 3.5h4.3v4.3" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        ))}
        <button class="action" type="button" data-copy-link>Copy link</button>
      </div>
    </header>

    <div class="article__body container">
      <div class="article__column">
        {post.data.takeaways.length > 0 && (
          <aside class="summary-panel" aria-labelledby="summary-title">
            <p class="kicker" id="summary-title">In short</p>
            <ol class="summary-panel__list">
              {post.data.takeaways.map((item) => <li>{item}</li>)}
            </ol>
          </aside>
        )}

        <div class="prose"><slot /></div>
      </div>

      {toc.length > 1 && (
        <details class="toc" data-toc>
          <summary class="toc__summary">Contents</summary>
          <ol class="toc__list">
            {toc.map((heading) => (
              <li class={heading.depth === 3 ? 'toc__item toc__item--sub' : 'toc__item'}>
                <a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )}
    </div>

    <footer class="article__foot container">
      <nav class="pager" aria-label="More entries">
        {previous ? (
          <a href={getPostUrl(previous)} rel="prev">
            <span class="pager__dir">Older</span>
            <span class="pager__title">{previous.data.title}</span>
          </a>
        ) : (
          <span class="pager__empty"></span>
        )}
        {next ? (
          <a class="pager--next" href={getPostUrl(next)} rel="next">
            <span class="pager__dir">Newer</span>
            <span class="pager__title">{next.data.title}</span>
          </a>
        ) : (
          <span class="pager__empty"></span>
        )}
      </nav>
    </footer>
  </article>
</BaseLayout>
